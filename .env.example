# Toast API credentials — copy to .env and fill in. Never commit the real .env.
#
# All four values come from Toast Web:
#   Integrations > Toast API access > Manage credentials
#
# TOAST_HOSTNAME comes from the "Copy API Access URL" button on the credential
# detail page. Do not guess it — Toast assigns the host and it differs by
# account. With or without the https:// prefix both work.
TOAST_HOSTNAME=

# "Copy Client ID" on the same page.
TOAST_CLIENT_ID=

# Shown once when the credential is created, and again only on rotation.
# If you no longer have it, use "Rotate client secret" to issue a new one.
TOAST_CLIENT_SECRET=

# The location GUID, also called Toast-Restaurant-External-ID or
# restaurantGuid. Toast emails it when standard API access is activated.
TOAST_RESTAURANT_GUID=
